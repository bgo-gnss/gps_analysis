# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments / tooling
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Knowledge graph (local redirect to the ecosystem root graph)
graphify-out/

# GBIS4TS vendored reference: keep code+Verification, drop heavy PDFs
reference/gbis4ts/*.pdf
reference/gbis4ts/**/*.rtf
reference/gbis4ts/**/*.html

# Cited papers: fetched on demand, never committed (same policy as above —
# and most publisher PDFs may not be redistributed even when readable here).
# Re-fetch any of them in one command:
#   python3 ~/.claude/skills/search-scholar/scripts/paper-get.py <doi> --out reference/papers
# See reference/papers/README.md for the citation-bearing list.
reference/papers/*.pdf
